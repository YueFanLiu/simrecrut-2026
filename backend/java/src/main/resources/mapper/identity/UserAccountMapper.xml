<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="fr.isep.simrecrut.mapper.identity.UserAccountMapper">

    <resultMap id="userAccountMap"
               type="fr.isep.simrecrut.entity.identity.UserAccount">
        <id property="id" column="id"/>
        <result property="publicId" column="public_id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="status" column="status"
                javaType="fr.isep.simrecrut.entity.identity.AccountStatus"/>
        <result property="emailVerifiedAt" column="email_verified_at"/>
        <result property="passwordUpdatedAt" column="password_updated_at"/>
        <result property="securityVersion" column="security_version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="accountColumns">
        id,
        public_id,
        username,
        email,
        password_hash,
        status,
        email_verified_at,
        password_updated_at,
        security_version,
        created_at,
        updated_at
    </sql>

    <select id="findById" resultMap="userAccountMap">
        SELECT <include refid="accountColumns"/>
        FROM sim_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="userAccountMap">
        SELECT <include refid="accountColumns"/>
        FROM sim_user
        WHERE username = #{username}
    </select>

    <select id="findByEmail" resultMap="userAccountMap">
        SELECT <include refid="accountColumns"/>
        FROM sim_user
        WHERE email = #{email}
    </select>

    <insert id="insert"
            parameterType="fr.isep.simrecrut.entity.identity.UserAccount"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO sim_user (
        public_id,
        username,
        email,
        password_hash,
        status,
        email_verified_at,
        password_updated_at,
        security_version,
        created_at,
        updated_at
        )
        VALUES (
        #{publicId},
        #{username},
        #{email},
        #{passwordHash},
        #{status},
        #{emailVerifiedAt},
        #{passwordUpdatedAt},
        #{securityVersion},
        #{createdAt},
        #{updatedAt}
        )
    </insert>

</mapper>
