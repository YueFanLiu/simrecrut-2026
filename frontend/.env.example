# Set to false to preview the registration-unavailable state, then restart Vite.
VITE_DEMO_REGISTRATION_ENABLED=true

# Use normal, empty or error to review Published Jobs states; restart Vite after changing.
VITE_DEMO_JOBS_SCENARIO=normal

# Use normal, unavailable or error to review Job Detail states; restart Vite after changing.
VITE_DEMO_JOB_DETAIL_SCENARIO=normal

# Use normal, unavailable or error to review demo case creation; restart Vite after changing.
VITE_DEMO_CASE_CREATION_SCENARIO=normal

# Use normal, retryable, final or upload-error for the extraction demo; restart Vite after changing.
VITE_DEMO_EXTRACTION_SCENARIO=normal

# Use normal, missing, empty, load-error, save-error or confirm-error; restart Vite.
VITE_DEMO_REVIEW_SCENARIO=normal

# Demo capability only. Future research visibility must use backend permission data.
VITE_DEMO_RESEARCH_ATTRIBUTES_ENABLED=false

# Use normal, retryable or final for fixed simulation states; restart Vite.
VITE_DEMO_SIMULATION_SCENARIO=normal

# Use normal, unassigned, submitted, human-update, load-error, refresh-error or delete-error.
# Restart Vite after changing; these are frontend fixtures only.
VITE_DEMO_RESULTS_SCENARIO=normal

# Use normal, error or delete-error for My simulations; restart Vite after changing.
VITE_DEMO_HISTORY_SCENARIO=normal

# Use normal, empty or error for the HR managed job list; restart Vite.
VITE_DEMO_HR_JOBS_SCENARIO=normal

# Use normal, load-error, save-error, extraction-error, validation-error, publish-error or conflict.
VITE_DEMO_HR_WIZARD_SCENARIO=normal

# Use normal, empty, load-error, detail-error or clone-error for job versions; restart Vite.
VITE_DEMO_HR_VERSIONS_SCENARIO=normal

# Use normal, empty or error for authorised HR cases; restart Vite.
VITE_DEMO_HR_CASES_SCENARIO=normal

# Use normal, error or blind for authorised case details; restart Vite.
VITE_DEMO_HR_DETAIL_SCENARIO=normal

# Use normal, empty or error for the Research experiments list; restart Vite.
VITE_DEMO_RESEARCH_EXPERIMENTS_SCENARIO=normal

# Use normal, empty or error for assigned review tasks; restart Vite.
VITE_DEMO_REVIEW_TASKS_SCENARIO=normal

# Use normal, load-error or submit-error for review details; restart Vite.
VITE_DEMO_REVIEW_DETAIL_SCENARIO=normal

# Use normal, empty, load-error, save-error or status-error; restart Vite.
VITE_DEMO_ADMIN_USERS_SCENARIO=normal

# Use normal, empty, load-error, save-error or assign-error; restart Vite.
VITE_DEMO_ADMIN_ROLES_SCENARIO=normal

# Use normal, empty, load-error, register-error or release-error; restart Vite.
VITE_DEMO_ADMIN_MODELS_SCENARIO=normal

# Frozen protocol inspection: normal, empty, load-error, detail-error.
VITE_DEMO_ADMIN_PROTOCOLS_SCENARIO=normal

# Service health: normal, empty, load-error, stale (synthetic timestamp only).
VITE_DEMO_ADMIN_HEALTH_SCENARIO=normal

# Failed tasks: normal, empty, load-error, detail-error.
VITE_DEMO_ADMIN_FAILURES_SCENARIO=normal

# Audit logs: normal, empty, load-error.
VITE_DEMO_ADMIN_AUDIT_SCENARIO=normal
