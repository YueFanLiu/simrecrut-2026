# Copy this file to .env in the repository root. Never commit real credentials.
# Values are literal strings. Shell expansion and multiline values are unsupported.

# Use an installed JDK 17. Windows example: D:/Java/jdk-17.
JAVA_HOME=/path/to/jdk-17
JAVA_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Fill these in when cloud MySQL access is supplied. Use provider-required TLS.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Redis is an internal dependency for sessions and caches.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Local inference address; a container deployment uses the internal service name.
# Both Java and inference receive the internal token. Frontend must not receive it.
ML_BASE_URL=http://127.0.0.1:8000
ML_INTERNAL_TOKEN=

# Java alone receives extraction-provider credentials.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Resolve these paths from the repository root when using the development helper.
# Containers will receive explicit mount paths in deployment configuration.
CASE_WORKSPACE_PATH=runtime/cases
MODEL_ARTIFACTS_PATH=model_artifacts

# RuoYi token signing secret: supply at least 32 random characters.
RUOYI_TOKEN_SECRET=
RUOYI_PROFILE=runtime/ruoyi-files
SIMRECRUT_DATA_DIR=runtime/resumes

# Authenticated resume publication uses server-only Aiven credentials and a CA file.
AIVEN_HOST=
AIVEN_PORT=
AIVEN_USER=
AIVEN_PASSWORD=
AIVEN_DATABASE=
AIVEN_CA_FILE=
